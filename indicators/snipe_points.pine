//@version=6
// =============================================================================
//  SNIPE POINTS — Session-Sweep-Reversal-Indikator (MGC / SIL / MNQ / MES)
//  ── VOLLBUILD: Session-Engine · Sweep · MSS/Displacement · Stop/Target ·
//     RR-Gate · Expansion-Score · SMT · VWAP-Rejection · Kalender · Turtle Soup
// =============================================================================
//  Zweck: seltene, hoch-asymmetrische 1m-Reversal-Setups (Ziel-RR >= 1:5).
//  Signal-Pipeline (Snipe-Modul):
//    1. Referenz-Level (Asia H/L, London-KZ H/L, Vortages-H/L, Rolling-24h)
//    2. SWEEP: Docht durchsticht Level (>= min. Ticks), Close zurück dahinter
//    3. MSS:  Close jenseits letzten Gegen-Swings innerhalb N Bars
//    4. DISPLACEMENT: MSS-Kerze Körper > k x Ø-Körper (opt. Strukturlevel)
//    5. STOP: Wick+Ticks | ATR(1m,n)*k | FVG-Rand (wählbar)
//    6. RR-GATE: nur ausgeben, wenn RR zum Ziel (Gegenseite Range) >= Min-RR
//    7. FILTER: Expansion-Score-Cutoff + optional SMT / VWAP-Rej. / Kalender
//  Turtle-Soup-Modul: separat aktivierbar (N-Tage-Extrem-Fehlausbruch).
//
//  ZEITBASIS: Haupt-Sessions in UTC (Input änderbar). LBMA-Fixes in
//  Europe/London (Fixes hängen an London-Lokalzeit → DST automatisch).
//    Asia Range        00:00–06:00 UTC — Pool, kein Trading
//    London Open KZ    07:00–10:00 UTC — Judas-Swing-Fenster
//    NY Pre-Market     12:00–13:30 UTC
//    NY Open / IB KZ   13:30–15:30 UTC — 24,2% HODs / 26,5% LODs (12.095-Studie)
//    PM / London Close 17:00–20:00 UTC — 35% aller HODs
//    LBMA AM/AG/PM-Fix 10:30 / 12:00 / 15:00 London  (Fenster ±15 min)
//
//  ANTI-REPAINT: State/Alerts nur auf barstate.isconfirmed; HTF- & SMT-
//  Requests mit lookahead_off + [1]-Offset.
//
//  WIEDERVERWENDET aus strategies/master_session_range.pine:
//  Range-Tracking-Muster, Sweep-Kernbedingung, Daily-request.security-Muster,
//  Structure-/ATR-Stop-Logik, Range-Filter-am-Tages-ATR-Gedanke (→ Score).
// =============================================================================
indicator("Snipe Points — Sweep Reversals", shorttitle = "SNIPE",
     overlay = true, max_boxes_count = 500, max_labels_count = 500,
     max_lines_count = 500)

// ===========================================================================
// INPUTS
// ===========================================================================
grpTz = "Zeitbasis"
tzMain = input.string("UTC", "Zeitzone Haupt-Sessions", group = grpTz, tooltip = "Referenzzone für Asia/London/NY/PM-Fenster. Default UTC.")
tzLbma = input.string("Europe/London", "Zeitzone LBMA-Fixes", group = grpTz, tooltip = "LBMA-Fixes hängen an London-Lokalzeit → Europe/London handhabt DST automatisch.")

grpSess = "Session-Fenster"
sessAsia   = input.session("0000-0600", "Asia Range (Pool)", group = grpSess, tooltip = "Liquiditätspool-Bildung. Kein Trading, nur H/L-Tracking.")
sessLonKz  = input.session("0700-1000", "London Open Killzone", group = grpSess)
sessNyPre  = input.session("1200-1330", "NY Pre-Market", group = grpSess)
sessNyOpen = input.session("1330-1530", "NY Open / Initial Balance", group = grpSess, tooltip = "Wichtigster Block für MNQ/MES: 24,2% aller Tages-Hochs, 26,5% aller Tages-Tiefs (12.095-Sessions-Studie).")
sessPm     = input.session("1700-2000", "PM / London Close", group = grpSess, tooltip = "35% aller Tages-Hochs, Peak 15:30 ET.")
sessFixAm  = input.session("1015-1045", "LBMA Gold AM-Fix (London-Zeit)", group = grpSess)
sessFixAg  = input.session("1145-1215", "LBMA Silver-Fix (London-Zeit)", group = grpSess)
sessFixPm  = input.session("1445-1515", "LBMA Gold PM-Fix (London-Zeit)", group = grpSess)
useLbma    = input.bool(true, "LBMA-Fix-Killzones aktiv", group = grpSess, tooltip = "MGC/SIL: an. MNQ/MES: aus.")
use24h     = input.bool(true, "24h-Modus: Rolling-Range-Sweeps", group = grpSess, tooltip = "Sweeps rund um die Uhr gegen Rolling-Range (Metalle). MNQ/MES: aus → nur Killzones.")
roll24Len  = input.int(360, "Rolling-Range Lookback (Bars)", minval = 30, group = grpSess, tooltip = "1m: 360 = 6h. Aktuelle Bar ausgenommen.")
blockAsia  = input.bool(true, "Kein Signal während Asia-Fenster", group = grpSess)

grpSweep = "Sweep-Detection"
minPenTicks = input.int(2, "Min. Penetration (Ticks)", minval = 0, group = grpSweep)
swpAsia   = input.bool(true, "Asia H/L sweepbar", group = grpSweep)
swpLondon = input.bool(true, "London-KZ H/L sweepbar", group = grpSweep)
swpPd     = input.bool(true, "Vortages-H/L sweepbar", group = grpSweep)

grpMss = "MSS / Displacement"
pivLeft    = input.int(3, "Swing-Pivot links", minval = 1, group = grpMss)
pivRight   = input.int(1, "Swing-Pivot rechts", minval = 1, group = grpMss)
mssWindow  = input.int(15, "Max. Bars Sweep → MSS", minval = 1, group = grpMss)
dispFactor = input.float(1.5, "Displacement-Faktor (x Ø-Körper)", step = 0.1, minval = 0.5, group = grpMss)
dispAvgLen = input.int(20, "Ø-Körper-Länge (Bars)", minval = 5, group = grpMss)
structFilt = input.string("Aus", "Zusatz: Close jenseits Strukturlevel", options = ["Aus", "Asia-Mid", "Tages-Open"], group = grpMss)

grpStop = "Stop / Target / RR-Gate"
stopMode   = input.string("Wick", "Stop-Methode", options = ["Wick", "ATR", "FVG"], group = grpStop, tooltip = "Wick: X Ticks hinter Sweep-Docht. ATR: ATR(1m,n)*k. FVG: Rand des Displacement-FVG (Fallback Wick).")
wickTicks  = input.int(3, "Wick-Stop: Ticks hinter Docht", minval = 0, group = grpStop)
atrLenStop = input.int(14, "ATR-Stop: Länge (n)", minval = 1, group = grpStop)
atrStopK   = input.float(1.0, "ATR-Stop: Faktor (k)", step = 0.05, minval = 0.1, group = grpStop)
fvgBufTicks= input.int(1, "FVG-Stop: Ticks Puffer", minval = 0, group = grpStop)
targetMode = input.string("Gegenseite-Range", "Ziel", options = ["Gegenseite-Range", "Vortages-Extrem"], group = grpStop, tooltip = "Gegenseite-Range = anderes Ende der gesweepten Range (Opposite-Sides-Regel 73–77%). Vortages-Extrem = PDH/PDL.")
useRrGate  = input.bool(true, "RR-Gate aktiv", group = grpStop)
minRR      = input.float(5.0, "Mindest-RR", step = 0.5, minval = 1.0, group = grpStop, tooltip = "Signal nur, wenn Ziel-RR >= diesem Wert. Default 1:5.")

grpScore = "Range-Expansion-Score"
useScore    = input.bool(true, "Expansion-Score-Gate aktiv", group = grpScore, tooltip = "Kombinierter, gewichteter Tages-Eignungs-Score. Cutoff kalibrierbar für ~1 Signal/Woche/Symbol.")
scoreCutoff = input.float(0.5, "Score-Cutoff (0..1)", step = 0.05, minval = 0.0, maxval = 1.0, group = grpScore)
useAtrReg   = input.bool(true, "Komponente: ATR-Regime", group = grpScore, tooltip = "Perzentil des 14-Tage-Daily-ATR über 60 Tage. Hoch = expansionsfreudiges Regime.")
wAtr        = input.float(1.0, "  Gewicht ATR-Regime", step = 0.1, minval = 0.0, group = grpScore)
atrLenReg   = input.int(14, "  Daily-ATR-Länge", minval = 1, group = grpScore)
atrPctLook  = input.int(60, "  Perzentil-Lookback (Tage)", minval = 10, group = grpScore)
useNarrowIb = input.bool(true, "Komponente: Narrow-IB", group = grpScore, tooltip = "Schmale NY-IB → höhere Extension. Score hoch wenn IB-Range klein vs. Tages-ATR.")
wIb         = input.float(1.0, "  Gewicht Narrow-IB", step = 0.1, minval = 0.0, group = grpScore)
ibRefK      = input.float(0.5, "  IB-Referenz (x Tages-ATR)", step = 0.05, minval = 0.05, group = grpScore)
useOnRange  = input.bool(true, "Komponente: Overnight-Range", group = grpScore, tooltip = "Kleine Asia/Overnight-Range → höhere RTH-Expansion. Score hoch wenn klein vs. Tages-ATR.")
wOn         = input.float(1.0, "  Gewicht Overnight-Range", step = 0.1, minval = 0.0, group = grpScore)
onRefK      = input.float(0.6, "  Overnight-Referenz (x Tages-ATR)", step = 0.05, minval = 0.05, group = grpScore)
useInside   = input.bool(true, "Komponente: Inside-Day", group = grpScore, tooltip = "Tag noch innerhalb Vortagesrange → aufgestaute Expansion.")
wId         = input.float(1.0, "  Gewicht Inside-Day", step = 0.1, minval = 0.0, group = grpScore)

grpSmt = "SMT-Divergenz (optional)"
useSmt    = input.bool(false, "SMT-Filter aktiv", group = grpSmt, tooltip = "Nur Signal, wenn Partnersymbol die Sweep-Bewegung NICHT bestätigt (Divergenz).")
partnerSym= input.symbol("", "Partnersymbol", group = grpSmt, tooltip = "MNQ↔MES, MGC↔SIL. Leer = deaktiviert (kein Partner).")
smtLen    = input.int(20, "SMT-Lookback (Bars)", minval = 3, group = grpSmt)

grpVwap = "VWAP-Rejection (optional)"
useVwapRej = input.bool(false, "VWAP-Rejection-Filter aktiv", group = grpVwap, tooltip = "Long nur wenn Kerze VWAP von unten antestet und darüber schließt (umgekehrt short).")

grpCal = "Kalender-Filter (optional)"
useCal  = input.bool(false, "Kalender-Filter aktiv", group = grpCal)
calMode = input.string("Blocken", "Modus", options = ["Blocken", "Nur an diesen Tagen"], group = grpCal, tooltip = "Blocken: an gelisteten Tagen KEIN Signal (FOMC/NFP/CPI/Feiertage). Nur: Signale ausschließlich an gelisteten Tagen.")
calCsv  = input.text_area("", "Datumsliste (YYYY-MM-DD, Komma-getrennt)", group = grpCal, tooltip = "z.B. 2026-07-30,2026-08-01. Manuell gepflegt, nicht hart verdrahtet.")

grpTurtle = "Turtle Soup (separates Modul)"
useTurtle = input.bool(false, "Turtle-Soup-Signale aktiv", group = grpTurtle, tooltip = "N-Tage-Extrem-Fehlausbruch (Daily). Unabhängig von der Sweep-Pipeline.")
tsN       = input.int(20, "N Tage (Extrem-Lookback)", minval = 2, group = grpTurtle)
tsEpsPct  = input.float(0.05, "Epsilon-Durchstich (%)", step = 0.01, minval = 0.0, group = grpTurtle, tooltip = "Mindest-Überschreitung des N-Tage-Extrems in % vor dem Reclaim.")
tsBufTicks= input.int(3, "Stop-Puffer hinter Spike (Ticks)", minval = 0, group = grpTurtle)
tsRR      = input.float(3.0, "Turtle-RR-Ziel", step = 0.5, minval = 1.0, group = grpTurtle)

grpVis = "Visualisierung & Signale"
showBoxes   = input.bool(true, "Session-Boxen", group = grpVis)
showLevels  = input.bool(true, "Referenz-Level", group = grpVis)
showSweeps  = input.bool(true, "Sweep-Marker", group = grpVis)
showSwpText = input.bool(false, "Sweep-Level als Text-Label", group = grpVis)
drawTrades  = input.bool(true, "Entry/SL/TP-Linien zeichnen", group = grpVis)
drawLen     = input.int(40, "Linienlänge (Bars nach rechts)", minval = 5, group = grpVis)
sigCooldown = input.int(30, "Cooldown zwischen Signalen (Bars)", minval = 0, group = grpVis)
showDash    = input.bool(true, "Dashboard", group = grpVis)

// ===========================================================================
// MODUL 1: SESSION-ENGINE  (Muster aus master_session_range.pine)
// ===========================================================================
f_inSess(string sess, string zone) =>
    not na(time(timeframe.period, sess, zone))

f_track(bool active) =>
    var float h    = na
    var float l    = na
    var bool  done = false
    if active and not active[1]
        h    := high
        l    := low
        done := false
    else if active
        h := math.max(h, high)
        l := math.min(l, low)
    if not active and active[1]
        done := true
    [h, l, done]

f_box(bool active, float h, float l, color col, string txt) =>
    // CE10235-sicher: kein if-Zweig gibt einen anderen Typ zurück als ein
    // anderer. Box bei Sessionstart anlegen, dann immer aktualisieren → der
    // terminale Ausdruck des Blocks ist stets void.
    var box b = na
    if showBoxes and active
        if na(b) or not active[1]
            b := box.new(bar_index, h, bar_index, l, border_color = color.new(col, 40), border_width = 1, bgcolor = color.new(col, 90), text = txt, text_color = color.new(col, 25), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top)
        box.set_right(b, bar_index)
        box.set_top(b, h)
        box.set_bottom(b, l)

inAsia   = f_inSess(sessAsia,   tzMain)
inLonKz  = f_inSess(sessLonKz,  tzMain)
inNyPre  = f_inSess(sessNyPre,  tzMain)
inNyOpen = f_inSess(sessNyOpen, tzMain)
inPm     = f_inSess(sessPm,     tzMain)
inFixAm  = f_inSess(sessFixAm,  tzLbma)
inFixAg  = f_inSess(sessFixAg,  tzLbma)
inFixPm  = f_inSess(sessFixPm,  tzLbma)

[asiaH, asiaL, asiaDone] = f_track(inAsia)
[lonH,  lonL,  lonDone]  = f_track(inLonKz)
[preH,  preL,  preDone]  = f_track(inNyPre)
[ibH,   ibL,   ibDone]   = f_track(inNyOpen)
[pmH,   pmL,   pmDone]   = f_track(inPm)
[amH,   amL,   amDone]   = f_track(inFixAm)
[agH,   agL,   agDone]   = f_track(inFixAg)
[pmxH,  pmxL,  pmxDone]  = f_track(inFixPm)

f_box(inAsia,   asiaH, asiaL, color.blue,    "ASIA")
f_box(inLonKz,  lonH,  lonL,  color.orange,  "LDN KZ")
f_box(inNyPre,  preH,  preL,  color.gray,    "NY PRE")
f_box(inNyOpen, ibH,   ibL,   color.green,   "NY IB")
f_box(inPm,     pmH,   pmL,   color.purple,  "PM/LC")
f_box(useLbma and inFixAm, amH,  amL,  color.yellow, "AM-FIX")
f_box(useLbma and inFixAg, agH,  agL,  color.silver, "AG-FIX")
f_box(useLbma and inFixPm, pmxH, pmxL, color.yellow, "PM-FIX")

inKz = inLonKz or inNyPre or inNyOpen or inPm or (useLbma and (inFixAm or inFixAg or inFixPm))
windowOk = (inKz or use24h) and not (blockAsia and inAsia)

// ===========================================================================
// REFERENZ-LEVEL & HTF-DATEN  (alle Requests lookahead_off + [1]-Offset)
// ===========================================================================
pdH = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_off)
pdL = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_off)

isNewDay = ta.change(time("D")) != 0
var float dayOpen = na
var float dayHi   = na
var float dayLo   = na
if isNewDay
    dayOpen := open
    dayHi   := high
    dayLo   := low
else
    dayHi   := math.max(dayHi, high)
    dayLo   := math.min(dayLo, low)

rollH = ta.highest(high, roll24Len)[1]
rollL = ta.lowest(low,  roll24Len)[1]

// Tages-ATR (Regime-Maßstab) + Perzentil, N-Tage-Extreme, SMT-Partner
atrD    = request.security(syminfo.tickerid, "D", ta.atr(atrLenReg)[1], lookahead = barmerge.lookahead_off)
atrPct  = request.security(syminfo.tickerid, "D", ta.percentrank(ta.atr(atrLenReg), atrPctLook)[1], lookahead = barmerge.lookahead_off)
ndayHi  = request.security(syminfo.tickerid, "D", ta.highest(high, tsN)[1], lookahead = barmerge.lookahead_off)
ndayLo  = request.security(syminfo.tickerid, "D", ta.lowest(low,  tsN)[1], lookahead = barmerge.lookahead_off)

smtSym  = partnerSym == "" ? syminfo.tickerid : partnerSym
pHigh   = request.security(smtSym, timeframe.period, high, lookahead = barmerge.lookahead_off)
pLow    = request.security(smtSym, timeframe.period, low,  lookahead = barmerge.lookahead_off)

vwap = ta.vwap(hlc3)
atrStop = ta.atr(atrLenStop)

// ===========================================================================
// MODUL 2: SWEEP-DETECTION  (Kernbedingung aus master_session_range.pine)
// ===========================================================================
pen = minPenTicks * syminfo.mintick
f_sweepBull(float lvl, bool valid) =>   // Tiefs gesweept → Long-Kontext
    valid and not na(lvl) and low <= lvl - pen and close > lvl
f_sweepBear(float lvl, bool valid) =>   // Hochs gesweept → Short-Kontext
    valid and not na(lvl) and high >= lvl + pen and close < lvl

swpBullAsia = f_sweepBull(asiaL, swpAsia and asiaDone)
swpBearAsia = f_sweepBear(asiaH, swpAsia and asiaDone)
swpBullLon  = f_sweepBull(lonL,  swpLondon and lonDone)
swpBearLon  = f_sweepBear(lonH,  swpLondon and lonDone)
swpBullPd   = f_sweepBull(pdL,   swpPd)
swpBearPd   = f_sweepBear(pdH,   swpPd)
swpBullRoll = use24h and not inKz and f_sweepBull(rollL, true)
swpBearRoll = use24h and not inKz and f_sweepBear(rollH, true)

// Sweep-Quelle + zugehöriges Ziel-Level (Gegenseite der gesweepten Range)
bool   bullSweepNow = false
string bullSrcNow   = na
float  bullOppNow   = na
if windowOk
    if swpBullAsia
        bullSweepNow := true
        bullSrcNow := "Asia-Low"
        bullOppNow := asiaH
    else if swpBullLon
        bullSweepNow := true
        bullSrcNow := "London-Low"
        bullOppNow := lonH
    else if swpBullPd
        bullSweepNow := true
        bullSrcNow := "PD-Low"
        bullOppNow := pdH
    else if swpBullRoll
        bullSweepNow := true
        bullSrcNow := "Roll-24h-Low"
        bullOppNow := rollH

bool   bearSweepNow = false
string bearSrcNow   = na
float  bearOppNow   = na
if windowOk
    if swpBearAsia
        bearSweepNow := true
        bearSrcNow := "Asia-High"
        bearOppNow := asiaL
    else if swpBearLon
        bearSweepNow := true
        bearSrcNow := "London-High"
        bearOppNow := lonL
    else if swpBearPd
        bearSweepNow := true
        bearSrcNow := "PD-High"
        bearOppNow := pdL
    else if swpBearRoll
        bearSweepNow := true
        bearSrcNow := "Roll-24h-High"
        bearOppNow := rollL

// ===========================================================================
// MODUL 3: MSS + DISPLACEMENT
// ===========================================================================
ph = ta.pivothigh(pivLeft, pivRight)
pl = ta.pivotlow(pivLeft, pivRight)
var float lastSwingH = na
var float lastSwingL = na
if not na(ph)
    lastSwingH := ph
if not na(pl)
    lastSwingL := pl

body    = math.abs(close - open)
avgBody = ta.sma(body, dispAvgLen)
asiaMid = (asiaH + asiaL) / 2
structRef = structFilt == "Asia-Mid" ? asiaMid : structFilt == "Tages-Open" ? dayOpen : na
dispLong  = body > dispFactor * avgBody and close > open and (structFilt == "Aus" or (not na(structRef) and close > structRef))
dispShort = body > dispFactor * avgBody and close < open and (structFilt == "Aus" or (not na(structRef) and close < structRef))

// Sweep-State: Wick (für Wick-Stop) + Ziel-Level snapshotten, N Bars gültig
var int    bullSwpBar  = na
var float  bullSwpWick = na
var string bullSwpSrc  = na
var float  bullSwpOpp  = na
var int    bearSwpBar  = na
var float  bearSwpWick = na
var string bearSwpSrc  = na
var float  bearSwpOpp  = na
var int    lastSigBar  = na

if barstate.isconfirmed
    if bullSweepNow
        bullSwpBar  := bar_index
        bullSwpWick := low
        bullSwpSrc  := bullSrcNow
        bullSwpOpp  := bullOppNow
    if bearSweepNow
        bearSwpBar  := bar_index
        bearSwpWick := high
        bearSwpSrc  := bearSrcNow
        bearSwpOpp  := bearOppNow
    if not na(bullSwpBar) and bar_index - bullSwpBar > mssWindow
        bullSwpBar := na
    if not na(bearSwpBar) and bar_index - bearSwpBar > mssWindow
        bearSwpBar := na

mssBull = not na(bullSwpBar) and not na(lastSwingH) and close > lastSwingH and dispLong
mssBear = not na(bearSwpBar) and not na(lastSwingL) and close < lastSwingL and dispShort

// ===========================================================================
// MODUL 4: STOP / TARGET / RR  (3 Stop-Methoden; RR relativ zu Entry=Close)
// ===========================================================================
tick = syminfo.mintick
bullFvg = low  > high[2]          // Displacement-Kerze reisst Gap auf (bullisch)
bearFvg = high < low[2]

// Long-Kandidat
lEntry = close
lSlWick = bullSwpWick - wickTicks * tick
lSlAtr  = close - atrStopK * atrStop
lSlFvg  = bullFvg ? high[2] - fvgBufTicks * tick : lSlWick   // Fallback Wick
lSL     = stopMode == "ATR" ? lSlAtr : stopMode == "FVG" ? lSlFvg : lSlWick
lTP     = targetMode == "Vortages-Extrem" ? pdH : bullSwpOpp
lTP    := na(lTP) ? pdH : lTP
lRisk   = lEntry - lSL
lRR     = (lRisk > 0 and not na(lTP) and lTP > lEntry) ? (lTP - lEntry) / lRisk : na
lRrOk   = not useRrGate or (not na(lRR) and lRR >= minRR)

// Short-Kandidat
sEntry = close
sSlWick = bearSwpWick + wickTicks * tick
sSlAtr  = close + atrStopK * atrStop
sSlFvg  = bearFvg ? low[2] + fvgBufTicks * tick : sSlWick
sSL     = stopMode == "ATR" ? sSlAtr : stopMode == "FVG" ? sSlFvg : sSlWick
sTP     = targetMode == "Vortages-Extrem" ? pdL : bearSwpOpp
sTP    := na(sTP) ? pdL : sTP
sRisk   = sSL - sEntry
sRR     = (sRisk > 0 and not na(sTP) and sTP < sEntry) ? (sEntry - sTP) / sRisk : na
sRrOk   = not useRrGate or (not na(sRR) and sRR >= minRR)

// ===========================================================================
// MODUL 5: RANGE-EXPANSION-SCORE  (gewichtet, 0..1, Cutoff kalibrierbar)
// ===========================================================================
f_clamp01(float x) => math.max(0.0, math.min(1.0, x))
cAtr = na(atrPct) ? 0.5 : atrPct / 100.0                       // hohes Regime → hoch
ibRange = ibDone ? (ibH - ibL) : na
cIb  = (na(ibRange) or na(atrD) or atrD <= 0) ? 0.5 : f_clamp01(1.0 - ibRange / (ibRefK * atrD))
onRange = asiaDone ? (asiaH - asiaL) : na
cOn  = (na(onRange) or na(atrD) or atrD <= 0) ? 0.5 : f_clamp01(1.0 - onRange / (onRefK * atrD))
insideDay = (not na(pdH) and not na(pdL) and not na(dayHi) and not na(dayLo)) and dayHi <= pdH and dayLo >= pdL
cId  = insideDay ? 1.0 : 0.0

float scNum = 0.0
float scDen = 0.0
if useAtrReg
    scNum += wAtr * cAtr
    scDen += wAtr
if useNarrowIb
    scNum += wIb * cIb
    scDen += wIb
if useOnRange
    scNum += wOn * cOn
    scDen += wOn
if useInside
    scNum += wId * cId
    scDen += wId
score   = scDen > 0 ? scNum / scDen : na
scoreOk = not useScore or (not na(score) and score >= scoreCutoff)

// ===========================================================================
// MODUL 6: OPTIONALE FILTER — SMT · VWAP-Rejection · Kalender
// ===========================================================================
// SMT: Partner bestätigt die Extrembildung NICHT (Divergenz stützt den Fade).
partnerActive = useSmt and partnerSym != ""
bullSmt = not partnerActive ? true : (low  <= ta.lowest(low,  smtLen)[1] and pLow  > ta.lowest(pLow,  smtLen)[1])
bearSmt = not partnerActive ? true : (high >= ta.highest(high, smtLen)[1] and pHigh < ta.highest(pHigh, smtLen)[1])

// VWAP-Rejection: Kerze testet VWAP an und schliesst auf der Setup-Seite zurück.
bullVwapRej = not useVwapRej or (low <= vwap and close > vwap)
bearVwapRej = not useVwapRej or (high >= vwap and close < vwap)

// Kalender: Datumsliste einmal parsen; Modus block/allow.
var array<string> calArr = na
if barstate.isfirst
    calArr := str.split(str.replace_all(calCsv, " ", ""), ",")
curDate  = str.format_time(time, "yyyy-MM-dd", tzMain)
isListed = not na(calArr) and array.size(calArr) > 0 and array.includes(calArr, curDate)
calBlocked = useCal and (calMode == "Blocken" ? isListed : not isListed)

// ===========================================================================
// FINALE SNIPE-SIGNALE  (Kandidat AND alle Gates)
// ===========================================================================
cooldownOk = na(lastSigBar) or bar_index - lastSigBar >= sigCooldown
gateCommon = barstate.isconfirmed and windowOk and cooldownOk and scoreOk and not calBlocked
longSignal  = gateCommon and mssBull and lRrOk and bullSmt and bullVwapRej
shortSignal = gateCommon and mssBear and sRrOk and bearSmt and bearVwapRej

f_drawTrade(float e, float sl, float tp, bool isLong) =>
    if drawTrades
        col = isLong ? color.lime : color.red
        line.new(bar_index, e,  bar_index + drawLen, e,  color = color.new(color.gray, 20), style = line.style_dashed)
        line.new(bar_index, sl, bar_index + drawLen, sl, color = color.new(color.red, 0), width = 1)
        line.new(bar_index, tp, bar_index + drawLen, tp, color = color.new(color.green, 0), width = 1)

var int longCount  = 0
var int shortCount = 0
if longSignal
    label.new(bar_index, low, "SNIPE LONG\n" + bullSwpSrc + "\nRR " + str.tostring(lRR, "#.#") + "  Score " + str.tostring(score, "#.##"), style = label.style_label_up, color = color.new(color.lime, 10), textcolor = color.black, size = size.small)
    f_drawTrade(lEntry, lSL, lTP, true)
    lastSigBar := bar_index
    bullSwpBar := na
    longCount  += 1
if shortSignal
    label.new(bar_index, high, "SNIPE SHORT\n" + bearSwpSrc + "\nRR " + str.tostring(sRR, "#.#") + "  Score " + str.tostring(score, "#.##"), style = label.style_label_down, color = color.new(color.red, 10), textcolor = color.white, size = size.small)
    f_drawTrade(sEntry, sSL, sTP, false)
    lastSigBar := bar_index
    bearSwpBar := na
    shortCount += 1

// ===========================================================================
// MODUL 7: TURTLE SOUP  (separates Signal — N-Tage-Extrem-Fehlausbruch)
// ===========================================================================
tsEps = tsEpsPct / 100.0
tsLongRaw  = useTurtle and not na(ndayLo) and low  <= ndayLo * (1.0 - tsEps) and close > ndayLo
tsShortRaw = useTurtle and not na(ndayHi) and high >= ndayHi * (1.0 + tsEps) and close < ndayHi

tsLongEntry = close
tsLongSL    = low - tsBufTicks * tick            // hinter Spike-Docht, NICHT im Spike
tsLongRisk  = tsLongEntry - tsLongSL
tsLongTP    = tsLongEntry + tsRR * tsLongRisk
tsLongOk    = tsLongRaw and barstate.isconfirmed and cooldownOk and tsLongRisk > 0

tsShortEntry = close
tsShortSL    = high + tsBufTicks * tick
tsShortRisk  = tsShortSL - tsShortEntry
tsShortTP    = tsShortEntry - tsRR * tsShortRisk
tsShortOk    = tsShortRaw and barstate.isconfirmed and cooldownOk and tsShortRisk > 0

var int tsCount = 0
if tsLongOk
    label.new(bar_index, low, "TURTLE LONG\n" + str.tostring(tsN) + "d-Low\nRR " + str.tostring(tsRR, "#.#"), style = label.style_label_up, color = color.new(color.teal, 10), textcolor = color.white, size = size.small)
    f_drawTrade(tsLongEntry, tsLongSL, tsLongTP, true)
    lastSigBar := bar_index
    tsCount += 1
if tsShortOk
    label.new(bar_index, high, "TURTLE SHORT\n" + str.tostring(tsN) + "d-High\nRR " + str.tostring(tsRR, "#.#"), style = label.style_label_down, color = color.new(color.maroon, 10), textcolor = color.white, size = size.small)
    f_drawTrade(tsShortEntry, tsShortSL, tsShortTP, false)
    lastSigBar := bar_index
    tsCount += 1

// ===========================================================================
// VISUALS
// ===========================================================================
plot(showLevels and asiaDone ? asiaH : na, "Asia High", color.new(color.blue, 35), 1, plot.style_linebr)
plot(showLevels and asiaDone ? asiaL : na, "Asia Low",  color.new(color.blue, 35), 1, plot.style_linebr)
plot(showLevels and lonDone ? lonH : na, "London High", color.new(color.orange, 45), 1, plot.style_linebr)
plot(showLevels and lonDone ? lonL : na, "London Low",  color.new(color.orange, 45), 1, plot.style_linebr)
plot(showLevels ? pdH : na, "Vortages-High", color.new(color.teal, 40), 1, plot.style_linebr)
plot(showLevels ? pdL : na, "Vortages-Low",  color.new(color.teal, 40), 1, plot.style_linebr)
plot(useVwapRej ? vwap : na, "VWAP", color.new(color.orange, 20), 1)

plotshape(showSweeps and bullSweepNow and barstate.isconfirmed, "Bull-Sweep", shape.triangleup,   location.belowbar, color.new(color.aqua, 0),    size = size.tiny, text = "swp")
plotshape(showSweeps and bearSweepNow and barstate.isconfirmed, "Bear-Sweep", shape.triangledown, location.abovebar, color.new(color.fuchsia, 0), size = size.tiny, text = "swp")

if showSwpText and barstate.isconfirmed
    if bullSweepNow
        label.new(bar_index, low, bullSrcNow, style = label.style_none, textcolor = color.new(color.aqua, 20), size = size.tiny)
    if bearSweepNow
        label.new(bar_index, high, bearSrcNow, style = label.style_none, textcolor = color.new(color.fuchsia, 20), size = size.tiny)

// ===========================================================================
// DASHBOARD  (Score-Transparenz + Signalzähler für den Frequenz-Sichttest)
// ===========================================================================
var table dash = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))
f_cell(int r, string k, string v, color c) =>
    table.cell(dash, 0, r, k, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if showDash and barstate.islast
    f_cell(0, "SNIPE POINTS", windowOk ? "FENSTER OFFEN" : "zu", windowOk ? color.lime : color.gray)
    f_cell(1, "Expansion-Score", na(score) ? "n/a" : str.tostring(score, "#.##") + (scoreOk ? " ✓" : " ✗"), na(score) ? color.gray : scoreOk ? color.lime : color.orange)
    f_cell(2, "  ATR-Regime %ile", na(atrPct) ? "n/a" : str.tostring(atrPct, "#"), color.white)
    f_cell(3, "  IB / Overnight", str.tostring(cIb, "#.##") + " / " + str.tostring(cOn, "#.##"), color.white)
    f_cell(4, "  Inside-Day", insideDay ? "ja" : "nein", insideDay ? color.lime : color.gray)
    f_cell(5, "Snipe L / S", str.tostring(longCount) + " / " + str.tostring(shortCount), color.white)
    f_cell(6, "Turtle-Signale", str.tostring(tsCount), color.white)
    f_cell(7, "Min-RR / Cutoff", str.tostring(minRR, "#.#") + " / " + str.tostring(scoreCutoff, "#.##"), color.white)

// ===========================================================================
// ALERTS
// ===========================================================================
alertcondition(longSignal,  "Snipe LONG",  "Snipe LONG: Sweep + MSS/Displacement, RR>=Min, Score OK")
alertcondition(shortSignal, "Snipe SHORT", "Snipe SHORT: Sweep + MSS/Displacement, RR>=Min, Score OK")
alertcondition(longSignal or shortSignal, "Snipe ANY", "Snipe-Signal (Long oder Short) ausgelöst")
alertcondition(tsLongOk,  "Turtle LONG",  "Turtle-Soup LONG: N-Tage-Tief-Fehlausbruch reclaimed")
alertcondition(tsShortOk, "Turtle SHORT", "Turtle-Soup SHORT: N-Tage-Hoch-Fehlausbruch reclaimed")
alertcondition(bullSweepNow and barstate.isconfirmed, "Bull-Sweep (früh)", "Bullischer Liquidity-Sweep — auf MSS warten")
alertcondition(bearSweepNow and barstate.isconfirmed, "Bear-Sweep (früh)", "Bärischer Liquidity-Sweep — auf MSS warten")
