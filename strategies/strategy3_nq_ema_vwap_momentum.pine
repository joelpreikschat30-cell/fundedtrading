//@version=6
// =============================================================================
//  STRATEGY 3 — NQ 5m Trend-Momentum EMA + VWAP Scalper (NQ / MNQ)
// =============================================================================
//  Recherche-Basis: "5m NQ Scalping 1:2 RR (Fixed SL)" (TradingView):
//  EMA(9/21)-Crossover in Richtung des VWAP-Trends, Volumen-Spike-Filter,
//  ATR-basierter fixer SL, TP = 2x SL, keine Trailing-Stops.
//
//  REGELN (Recherche-Mapping mit [R#]):
//   [R1] 5m NQ/MNQ, nur US-RTH 09:30-16:00 New York
//   [R2] Fast EMA 9 / Slow EMA 21; Long-Bias bei Crossover nach oben
//   [R3] VWAP (Session-Anker): Slope > 0 für Longs, < 0 für Shorts
//   [R4] Volumen-Filter: Volume > 20-Bar-Volumen-MA (echte Beteiligung)
//   [R5] SL = k x ATR(14), k = 1.0-1.5 (default 1.25); TP = 2 x SL (1:2 RR)
//   [R6] Kein Trailing — Exit strikt über SL/TP
//   [R7] Micro-Kontrakte (MNQ) für kleine Konten; Sizing über % Equity
//   [R8] Risiko 0.25-0.5%/Trade, Daily-Loss 2-3%, Max 3-6 Trades/Tag,
//        optional Tages-GEWINN-Ziel (Stop nach +3-4% zum Konsistenz-Schutz)
//   [R9] Max-Drawdown-Kill-Switch (Prop-Trailing-DD)
//
//  ANTI-REPAINT: Entries nur auf barstate.isconfirmed; kein request.security
//  nötig (alles Chart-TF); VWAP/EMAs auf bestätigten Bars ausgewertet;
//  process_orders_on_close = true.
//
//  FUTURES-SETUP: NQ Tick 0.25 = $5 (Punktwert $20); MNQ Tick 0.25 = $0.50
//  (Punktwert $2). Kommission $2/Kontrakt/Seite, Slippage 4 Ticks = 1 Punkt.
// =============================================================================
strategy("S3 NQ 5m EMA + VWAP Momentum [v6]",
     shorttitle            = "S3 NQ MOM",
     overlay               = true,
     initial_capital       = 50000,
     currency              = currency.USD,
     default_qty_type      = strategy.fixed,
     default_qty_value     = 1,
     pyramiding            = 0,
     commission_type       = strategy.commission.cash_per_contract,
     commission_value      = 2.0,
     slippage              = 4,       // 4 Ticks = 1 NQ-Punkt
     margin_long           = 5,
     margin_short          = 5,
     process_orders_on_close = true,
     calc_on_every_tick    = false,
     use_bar_magnifier     = false)

// ---------------------------------------------------------------------------
// INPUTS
// ---------------------------------------------------------------------------
grpSig = "Signal"
emaFastLen = input.int(9,  "Fast EMA", minval = 2, group = grpSig, tooltip = "[R2]")
emaSlowLen = input.int(21, "Slow EMA", minval = 3, group = grpSig, tooltip = "[R2]")
vwapSlopeLen = input.int(5, "VWAP-Slope-Fenster (Bars)", minval = 2, group = grpSig, tooltip = "[R3] Slope = LinReg-Differenz des VWAP über n Bars. >0 nur Longs, <0 nur Shorts.")
useVolFilter = input.bool(true, "Volumen-Spike-Filter", group = grpSig, tooltip = "[R4]")
volMaLen   = input.int(20, "Volumen-MA Länge", minval = 2, group = grpSig)
volMult    = input.float(1.0, "Volumen-Schwelle (x MA)", step = 0.1, minval = 0.5, group = grpSig, tooltip = "[R4] Entry nur wenn Volume > x * SMA(Volume). Recherche: 1.0.")

grpExit = "Stops & Targets"
atrLen     = input.int(14,    "ATR Länge", minval = 1, group = grpExit)
atrSlMult  = input.float(1.25, "SL-Multiplikator k (x ATR)", step = 0.05, minval = 0.25, group = grpExit, tooltip = "[R5] Recherche: 1.0-1.5.")
rrTarget   = input.float(2.0,  "RR-Ziel (TP = RR x SL)", step = 0.1, minval = 0.5, group = grpExit, tooltip = "[R5] 1:2 wie in der Publikation. [R6] Kein Trailing.")
maxBarsHold = input.int(24,   "Time-Stop (Bars)", minval = 1, group = grpExit, tooltip = "Sicherheitsnetz: 24 x 5m = 2h. Verhindert Position bis Session-Ende.")

grpSess = "Session"
sessStr  = input.session("0930-1600", "US-RTH-Session", group = grpSess, tooltip = "[R1] Regular Trading Hours New York.")
sessTz   = input.string("America/New_York", "Session-Zeitzone", group = grpSess)
closeEod = input.bool(true, "Am Session-Ende flatten", group = grpSess)

grpRisk = "Risiko & Prop-Firm-Limits"
riskPct      = input.float(0.5, "Risiko pro Trade (% Equity)", step = 0.05, minval = 0.05, maxval = 2.0, group = grpRisk, tooltip = "[R7]+[R8] Kontrakte = RisikoUSD / (SL-Distanz x Punktwert). Auf MNQ testen, bevor NQ gehandelt wird.")
maxContracts = input.int(10, "Max. Kontrakte", minval = 1, group = grpRisk)
maxTradesDay = input.int(5,  "Max. Trades pro Tag", minval = 1, group = grpRisk, tooltip = "[R8] Recherche: 3-6 Qualitäts-Setups.")
dailyLossPct = input.float(3.0, "Daily-Loss-Limit (%)", step = 0.25, minval = 0.5, group = grpRisk)
dailyProfitTargetPct = input.float(4.0, "Tages-Gewinnziel (%, 0 = aus)", step = 0.5, minval = 0.0, group = grpRisk, tooltip = "[R8] Nach Erreichen: keine neuen Entries mehr heute (Konsistenz-Schutz für Prop-Konten).")
maxDdPct     = input.float(6.0, "Max-Drawdown-Kill-Switch (%)", step = 0.25, minval = 1.0, group = grpRisk, tooltip = "[R9] Trailing-DD vom Equity-Peak — wie Prop-Trailing-Drawdown.")
showDash     = input.bool(true, "Dashboard anzeigen", group = grpRisk)

// ---------------------------------------------------------------------------
// v6 UDT + METHODS: Risiko-/Tages-State
// ---------------------------------------------------------------------------
type RiskState
    float dayStartEquity = na
    float peakEquity     = na
    int   tradesToday    = 0
    bool  dayHalted      = false
    bool  killed         = false

method newDay(RiskState self) =>
    self.dayStartEquity := strategy.equity
    self.tradesToday    := 0
    self.dayHalted      := false

method dailyDrawdownPct(RiskState self) =>
    na(self.dayStartEquity) or self.dayStartEquity <= 0 ? 0.0 :
     100.0 * (self.dayStartEquity - strategy.equity) / self.dayStartEquity

method dailyProfitPct(RiskState self) =>
    na(self.dayStartEquity) or self.dayStartEquity <= 0 ? 0.0 :
     100.0 * (strategy.equity - self.dayStartEquity) / self.dayStartEquity

method totalDrawdownPct(RiskState self) =>
    na(self.peakEquity) or self.peakEquity <= 0 ? 0.0 :
     100.0 * (self.peakEquity - strategy.equity) / self.peakEquity

method remainingDayBudget(RiskState self) =>
    na(self.dayStartEquity) ? 0.0 :
     math.max(0.0, self.dayStartEquity * dailyLossPct / 100.0 - (self.dayStartEquity - strategy.equity))

var RiskState rs = RiskState.new()

// ---------------------------------------------------------------------------
// SIGNALLOGIK
// ---------------------------------------------------------------------------
inRTH   = not na(time(timeframe.period, sessStr, sessTz))   // [R1]
emaFast = ta.ema(close, emaFastLen)                          // [R2]
emaSlow = ta.ema(close, emaSlowLen)
vwap    = ta.vwap(hlc3)                                      // [R3] Session-verankerter VWAP
atr     = ta.atr(atrLen)
volMA   = ta.sma(volume, volMaLen)                           // [R4]

// [R3] VWAP-Slope über LinReg-Differenz (wie im Pseudo-Code der Recherche)
vwapSlope = ta.linreg(vwap, vwapSlopeLen, 0) - ta.linreg(vwap, vwapSlopeLen, 1)

// [R2] EMA-Crossover
emaCrossUp = ta.crossover(emaFast, emaSlow)
emaCrossDn = ta.crossunder(emaFast, emaSlow)

// [R4] Volumen-Spike
volSpike = not useVolFilter or volume > volMult * volMA

// ---------------------------------------------------------------------------
// [R8]+[R9] DAILY-LOSS-LIMITER, GEWINNZIEL & KILL-SWITCH
// ---------------------------------------------------------------------------
isNewDay = ta.change(time("D")) != 0
if isNewDay
    rs.newDay()
if na(rs.peakEquity) or strategy.equity > rs.peakEquity
    rs.peakEquity := strategy.equity

if not rs.killed and rs.totalDrawdownPct() >= maxDdPct
    rs.killed := true
    strategy.close_all(comment = "KILL max-DD", immediately = true)
    strategy.cancel_all()

if not rs.dayHalted and rs.dailyDrawdownPct() >= dailyLossPct
    rs.dayHalted := true
    strategy.close_all(comment = "HALT daily-loss", immediately = true)
    strategy.cancel_all()

// [R8] Tages-Gewinnziel: keine NEUEN Trades mehr (offene laufen regulär aus)
profitTargetHit = dailyProfitTargetPct > 0 and rs.dailyProfitPct() >= dailyProfitTargetPct

allowNewTrades = not rs.killed and not rs.dayHalted and not profitTargetHit and
     inRTH and rs.tradesToday < maxTradesDay

// ---------------------------------------------------------------------------
// POSITION SIZING [R7]
// ---------------------------------------------------------------------------
calcQty(float slDist) =>
    riskUsd = strategy.equity * riskPct / 100.0
    perCon  = slDist * syminfo.pointvalue     // NQ: $20/Punkt, MNQ: $2/Punkt
    qty     = perCon > 0 ? math.floor(riskUsd / perCon) : 0
    math.min(math.max(qty, 0), maxContracts)

// ---------------------------------------------------------------------------
// ENTRIES — nur bestätigte Bars
// ---------------------------------------------------------------------------
// [R2]+[R3]+[R4] Long: EMA-Cross hoch + steigender VWAP + Volumen-Spike
longCond  = allowNewTrades and strategy.position_size == 0 and emaCrossUp and vwapSlope > 0 and volSpike
// Spiegel-Short
shortCond = allowNewTrades and strategy.position_size == 0 and emaCrossDn and vwapSlope < 0 and volSpike

if longCond and barstate.isconfirmed
    slDist = atrSlMult * atr                  // [R5]
    if slDist > 0
        qty = calcQty(slDist)
        if qty >= 1
            strategy.entry("Long", strategy.long, qty = qty)
            strategy.exit("LongX", "Long", stop = close - slDist, limit = close + rrTarget * slDist)  // [R5]+[R6]
            rs.tradesToday += 1

if shortCond and barstate.isconfirmed
    slDist = atrSlMult * atr
    if slDist > 0
        qty = calcQty(slDist)
        if qty >= 1
            strategy.entry("Short", strategy.short, qty = qty)
            strategy.exit("ShortX", "Short", stop = close + slDist, limit = close - rrTarget * slDist)
            rs.tradesToday += 1

// Time-Stop (Sicherheitsnetz)
if strategy.opentrades > 0 and barstate.isconfirmed
    entryBar = strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    if bar_index - entryBar >= maxBarsHold
        strategy.close_all(comment = "Time-Stop")

// [R1] RTH-Ende: flatten (kein Overnight auf Prop-Konto)
if closeEod and not inRTH and strategy.position_size != 0 and barstate.isconfirmed
    strategy.close_all(comment = "EOD flat")

// ---------------------------------------------------------------------------
// DASHBOARD
// ---------------------------------------------------------------------------
var table dash = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))

cell(int r, string k, string v, color c) =>
    table.cell(dash, 0, r, k, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if showDash and barstate.islast
    winRate = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : na
    pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    statusTxt = rs.killed ? "KILLED" : rs.dayHalted ? "DAY HALT" : profitTargetHit ? "ZIEL ERREICHT" : "AKTIV"
    statusCol = rs.killed ? color.red : rs.dayHalted ? color.orange : profitTargetHit ? color.aqua : color.lime
    cell(0, "S3 NQ MOM", statusTxt, statusCol)
    cell(1, "Trades (gesamt)", str.tostring(strategy.closedtrades), color.white)
    cell(2, "Win-Rate", na(winRate) ? "n/a" : str.tostring(winRate, "#.1") + "%", color.white)
    cell(3, "Profit Factor", na(pf) ? "n/a" : str.tostring(pf, "#.##"), na(pf) ? color.gray : pf >= 1 ? color.lime : color.red)
    cell(4, "Tages-DD", str.tostring(rs.dailyDrawdownPct(), "#.##") + "%", rs.dailyDrawdownPct() > dailyLossPct * 0.66 ? color.orange : color.white)
    cell(5, "Rest-Tagesbudget", "$" + str.tostring(rs.remainingDayBudget(), "#"), color.white)
    cell(6, "Gesamt-DD (Peak)", str.tostring(rs.totalDrawdownPct(), "#.##") + "%", rs.totalDrawdownPct() > maxDdPct * 0.66 ? color.orange : color.white)
    cell(7, "Trades heute", str.tostring(rs.tradesToday) + " / " + str.tostring(maxTradesDay), color.white)
    cell(8, "Tages-P&L", str.tostring(rs.dailyProfitPct(), "#.##") + "%", rs.dailyProfitPct() >= 0 ? color.lime : color.red)

// ---------------------------------------------------------------------------
// VISUALS
// ---------------------------------------------------------------------------
plot(emaFast, "EMA Fast", color = color.new(color.lime, 30))
plot(emaSlow, "EMA Slow", color = color.new(color.red, 30))
plot(vwap,    "VWAP",     color = color.new(color.purple, 10), linewidth = 2)
plotshape(longCond and barstate.isconfirmed,  "Long",  shape.triangleup,   location.belowbar, color.lime, size = size.tiny)
plotshape(shortCond and barstate.isconfirmed, "Short", shape.triangledown, location.abovebar, color.red,  size = size.tiny)
bgcolor(rs.killed ? color.new(color.red, 85) : rs.dayHalted ? color.new(color.orange, 88) : inRTH ? na : color.new(color.gray, 94))
