//@version=6
// =============================================================================
//  STRATEGY 1 — Gold 5m Trend-Pullback Engulfing (XAUUSD / GC / MGC)
// =============================================================================
//  Recherche-Basis: "5-Min Gold Scalping Strategy with 1:3 RR" +
//  "Gold Scalping Strategy with Precise Entries" (TradingView).
//
//  REGELN (jede Regel aus der Recherche ist unten im Code markiert mit [R#]):
//   [R1]  Entry-Chart 5m, Trendfilter 15m (HH/HL-Struktur und/oder EMA50>EMA200)
//   [R2]  Session-Filter: nur London+NY-Overlap (default 08:00-16:00 Europe/London)
//   [R3]  Long: 15m-Bulltrend + 5m-Pullback an Swing-Low + Bullish Engulfing
//   [R4]  Optional-Filter: RSI(14) 45-55 VOR dem Engulfing, Close > EMA50 (5m)
//   [R5]  Nähe zum Swing-Level: |close - swingLow| <= 0.5 * ATR(14)
//   [R6]  Stop: unter Swing-Low (Puffer 0.1*ATR) ODER rein ATR-basiert
//   [R7]  Target: RR-Ziel 1:2 bis 1:3 (default 2.5x Stop-Distanz)
//   [R8]  Time-Stop: Trade schließen nach 45-60 min (default 12 x 5m-Bars)
//   [R9]  Risiko 0.25-0.5% Equity/Trade, max. Trades/Tag begrenzt
//   [R10] Daily-Loss-Limiter (default 3%) + Max-Drawdown-Kill-Switch (default 6%)
//
//  ANTI-REPAINT: Alle Entries nur auf barstate.isconfirmed. Alle
//  request.security()-Aufrufe mit lookahead=barmerge.lookahead_off und
//  [1]-Offset (letzter ABGESCHLOSSENER 15m-Wert -> kein Repaint, kein Leak).
//
//  Pine v6 Features genutzt: User-Defined Types + Methods (Risk-State),
//  Boolean Short-Circuit (v6 wertet and/or lazy aus -> security-Calls u.
//  teure Checks stehen bewusst hinten), kein Trade-Limit mehr in v6.
//
//  FUTURES-SETUP (GC: Tick 0.1 = $10, MGC: Tick 0.1 = $1):
//  commission = cash pro Kontrakt & Seite, slippage in Ticks,
//  margin_long/short ~5% Notional (Overnight-Initial-Margin-Näherung).
// =============================================================================
strategy("S1 Gold 5m Trend-Pullback Engulfing [v6]",
     shorttitle            = "S1 GOLD TPE",
     overlay               = true,
     initial_capital       = 50000,
     currency              = currency.USD,
     default_qty_type      = strategy.fixed,
     default_qty_value     = 1,
     pyramiding            = 0,
     commission_type       = strategy.commission.cash_per_contract,
     commission_value      = 2.5,     // $/Kontrakt/Seite (GC-Retail-Broker)
     slippage              = 2,       // 2 Ticks = 0.2 Punkte Gold
     margin_long           = 5,
     margin_short          = 5,
     process_orders_on_close = true,  // Orders auf Bar-Close -> passt zu isconfirmed
     calc_on_every_tick    = false,   // kein Intrabar-Repaint
     use_bar_magnifier     = false)

// ---------------------------------------------------------------------------
// INPUTS
// ---------------------------------------------------------------------------
grpTrend  = "Trendfilter (15m)"
htfTf        = input.timeframe("15", "Trend-Timeframe", group = grpTrend, tooltip = "Höherer Timeframe für den Trendfilter. Recherche: 15m.")
swingLenHtf  = input.int(5,  "HTF Swing-Länge (Bars)", minval = 2, group = grpTrend, tooltip = "[R1] Rollierende Highest-High/Low-Fenster auf dem 15m-Chart.")
structShift  = input.int(10, "HTF Struktur-Vergleich [n]", minval = 1, group = grpTrend, tooltip = "[R1] Bulltrend wenn HH > HH[n] und HL > HL[n] auf 15m.")
useEmaTrend  = input.bool(true, "Zusätzlich EMA50>EMA200 (15m) verlangen", group = grpTrend, tooltip = "[R1] Zweiter Trendfilter aus der Recherche (Gold Scalping Precise Entries).")

grpEntry  = "Entry (5m)"
swingLen     = input.int(5,    "5m Swing-Länge (Bars)", minval = 2, group = grpEntry, tooltip = "[R3] Lokales Swing-Low/High = Lowest/Highest der letzten n Bars.")
engulfMode   = input.string("Body", "Engulfing-Modus", options = ["Body", "Range (strikt)"], group = grpEntry, tooltip = "[R3] 'Range (strikt)' = Recherche-Definition (Close über High[1] UND Open unter Low[1]) — auf gap-armen Futures extrem selten. 'Body' = Standard-Definition (Body umschließt Vorbar-Body) — praxistauglicher Default.")
useRsiFilter = input.bool(true, "RSI-Konsolidierungsfilter", group = grpEntry)
rsiLen       = input.int(14,   "RSI Länge", minval = 2, group = grpEntry)
rsiLo        = input.float(45, "RSI Untergrenze (vor Engulfing)", group = grpEntry, tooltip = "[R4] RSI[1] muss zwischen Unter- und Obergrenze liegen (Konsolidierung vor Ausbruch).")
rsiHi        = input.float(55, "RSI Obergrenze (vor Engulfing)", group = grpEntry)
useEma50     = input.bool(true, "Close über/unter EMA50 (5m) verlangen", group = grpEntry, tooltip = "[R4]")
ema50Len     = input.int(50,   "EMA-Länge (5m Filter)", minval = 2, group = grpEntry)
proxAtrMult  = input.float(0.5, "Max. Distanz zum Swing (x ATR)", step = 0.1, minval = 0.1, group = grpEntry, tooltip = "[R5] Engulfing muss <= x*ATR vom Swing-Level entfernt schließen.")

grpExit   = "Stops & Targets"
atrLen       = input.int(14,   "ATR Länge", minval = 1, group = grpExit)
stopMode     = input.string("Swing", "Stop-Modus", options = ["Swing", "ATR"], group = grpExit, tooltip = "[R6] Swing: unter Swing-Low + 0.1*ATR Puffer. ATR: Entry -/+ k*ATR.")
atrStopMult  = input.float(1.25, "ATR-Stop-Multiplikator k", step = 0.05, minval = 0.25, group = grpExit, tooltip = "[R6] Nur bei Stop-Modus ATR: SL-Distanz = k * ATR(14). Recherche: 1.0-1.5.")
swingBufMult = input.float(0.1,  "Swing-Stop-Puffer (x ATR)", step = 0.05, minval = 0.0, group = grpExit)
rrTarget     = input.float(2.5,  "RR-Ziel (TP = RR x SL-Distanz)", step = 0.1, minval = 0.5, group = grpExit, tooltip = "[R7] Recherche: 1:2 bis 1:3 -> default 2.5.")
maxBarsHold  = input.int(12,     "Time-Stop (Bars im Trade)", minval = 1, group = grpExit, tooltip = "[R8] 12 x 5m = 60 min. Danach Market-Exit.")

grpSess   = "Session"
sessStr      = input.session("0800-1600", "Handels-Session", group = grpSess, tooltip = "[R2] London+NY-Overlap. Außerhalb: keine neuen Entries.")
sessTz       = input.string("Europe/London", "Session-Zeitzone", group = grpSess)
closeEod     = input.bool(true, "Offene Position am Session-Ende schließen", group = grpSess)

grpRisk   = "Risiko & Prop-Firm-Limits"
riskPct      = input.float(0.5, "Risiko pro Trade (% Equity)", step = 0.05, minval = 0.05, maxval = 2.0, group = grpRisk, tooltip = "[R9] Position-Sizing: Kontrakte = RisikoUSD / (SL-Distanz x Punktwert). Recherche: 0.25-0.5%.")
maxContracts = input.int(10, "Max. Kontrakte", minval = 1, group = grpRisk)
maxTradesDay = input.int(6,  "Max. Trades pro Tag", minval = 1, group = grpRisk, tooltip = "[R9] Recherche: 5-8, um Overtrading/Kommissionen zu begrenzen.")
dailyLossPct = input.float(3.0, "Daily-Loss-Limit (%)", step = 0.25, minval = 0.5, group = grpRisk, tooltip = "[R10] Bei Erreichen: alle Positionen schließen, keine Entries bis zum nächsten Tag. Prop-Firm-Grenze konfigurierbar.")
maxDdPct     = input.float(6.0, "Max-Drawdown-Kill-Switch (%)", step = 0.25, minval = 1.0, group = grpRisk, tooltip = "[R10] Trailing-DD vom Equity-Peak. Bei Erreichen: alles schließen, Strategie DAUERHAFT deaktiviert.")
showDash     = input.bool(true, "Dashboard anzeigen", group = grpRisk)

// ---------------------------------------------------------------------------
// v6 UDT + METHODS: Risiko-/Tages-State
// ---------------------------------------------------------------------------
type RiskState
    float dayStartEquity = na
    float peakEquity     = na
    int   tradesToday    = 0
    bool  dayHalted      = false   // Daily-Loss-Limit erreicht
    bool  killed         = false   // Max-DD-Kill-Switch ausgelöst (permanent)

method newDay(RiskState self) =>
    self.dayStartEquity := strategy.equity
    self.tradesToday    := 0
    self.dayHalted      := false

method dailyDrawdownPct(RiskState self) =>
    na(self.dayStartEquity) or self.dayStartEquity <= 0 ? 0.0 :
     100.0 * (self.dayStartEquity - strategy.equity) / self.dayStartEquity

method totalDrawdownPct(RiskState self) =>
    na(self.peakEquity) or self.peakEquity <= 0 ? 0.0 :
     100.0 * (self.peakEquity - strategy.equity) / self.peakEquity

// Verbleibendes Tagesrisiko-Budget in USD (für Dashboard)
method remainingDayBudget(RiskState self) =>
    na(self.dayStartEquity) ? 0.0 :
     math.max(0.0, self.dayStartEquity * dailyLossPct / 100.0 - (self.dayStartEquity - strategy.equity))

var RiskState rs = RiskState.new()

// ---------------------------------------------------------------------------
// [R2] SESSION-FILTER
// ---------------------------------------------------------------------------
inSession = not na(time(timeframe.period, sessStr, sessTz))

// ---------------------------------------------------------------------------
// [R1] 15m-TRENDFILTER — anti-repaint: [1]-Offset + lookahead_off
//      liefert den letzten ABGESCHLOSSENEN 15m-Wert (kein Zukunfts-Leak).
// ---------------------------------------------------------------------------
htfHH  = ta.highest(high, swingLenHtf)
htfHL  = ta.highest(low,  swingLenHtf)
htfLH  = ta.lowest(high,  swingLenHtf)
htfLL  = ta.lowest(low,   swingLenHtf)
htfE50  = ta.ema(close, 50)
htfE200 = ta.ema(close, 200)

// v6: ein security-Call mit Tuple (dynamische Requests sind in v6 Standard)
[hh, hl, lh, ll, e50h, e200h] =
     request.security(syminfo.tickerid, htfTf,
         [htfHH[1], htfHL[1], htfLH[1], htfLL[1], htfE50[1], htfE200[1]],
         lookahead = barmerge.lookahead_off)

// [R1] Bulltrend: HH > HH[n] und HL > HL[n] (auf 15m-Basis, n=structShift 15m-Bars
//      ~ structShift*3 Chart-Bars; wir vergleichen auf Chart-Bars konservativ *3)
shiftBars = structShift * 3
structUp = hh > hh[shiftBars] and hl > hl[shiftBars]
structDn = lh < lh[shiftBars] and ll < ll[shiftBars]

trendUp = structUp and (not useEmaTrend or e50h > e200h)
trendDn = structDn and (not useEmaTrend or e50h < e200h)

// ---------------------------------------------------------------------------
// [R3] 5m SWINGS + ENGULFING
// ---------------------------------------------------------------------------
// Swing-Level der VOR-Bars ([1]-Shift): das Pullback-Ziel. Die aktuelle
// Engulfing-Kerze muss diese Zone mit ihrem Low (Long) bzw. High (Short)
// angelaufen haben — der Close liegt bei einer Engulfing-Kerze naturgemäß
// weit vom Swing entfernt, daher wird das Low/High geprüft [R5].
swingLow  = ta.lowest(low,  swingLen)[1]
swingHigh = ta.highest(high, swingLen)[1]

// [R3] Bullish Engulfing — zwei Modi:
//  "Range (strikt)": Recherche-Definition — Close über High[1], Open unter Low[1]
//  "Body":           Standard — Body umschließt den Vorbar-BODY (Default)
strictMode = engulfMode == "Range (strikt)"
bullEngulf = strictMode ?
     (close > open and close[1] < open[1] and close > high[1]  and open < low[1]) :
     (close > open and close[1] < open[1] and close >= open[1] and open <= close[1])
// Bearish Engulfing (Spiegel)
bearEngulf = strictMode ?
     (close < open and close[1] > open[1] and close < low[1]   and open > high[1]) :
     (close < open and close[1] > open[1] and close <= open[1] and open >= close[1])

rsi   = ta.rsi(close, rsiLen)
ema50 = ta.ema(close, ema50Len)
atr   = ta.atr(atrLen)

// [R4] RSI-Konsolidierung VOR dem Engulfing -> rsi[1]
rsiOk = not useRsiFilter or (rsi[1] > rsiLo and rsi[1] < rsiHi)

// ---------------------------------------------------------------------------
// [R10] DAILY-LOSS-LIMITER + KILL-SWITCH
// ---------------------------------------------------------------------------
isNewDay = ta.change(time("D")) != 0
if isNewDay
    rs.newDay()
if na(rs.peakEquity) or strategy.equity > rs.peakEquity
    rs.peakEquity := strategy.equity

if not rs.killed and rs.totalDrawdownPct() >= maxDdPct
    rs.killed := true
    strategy.close_all(comment = "KILL max-DD", immediately = true)
    strategy.cancel_all()

if not rs.dayHalted and rs.dailyDrawdownPct() >= dailyLossPct
    rs.dayHalted := true
    strategy.close_all(comment = "HALT daily-loss", immediately = true)
    strategy.cancel_all()

// v6 Short-Circuit: billige Flags zuerst
allowNewTrades = not rs.killed and not rs.dayHalted and inSession and rs.tradesToday < maxTradesDay

// ---------------------------------------------------------------------------
// POSITION SIZING [R9]: Kontrakte = RisikoUSD / (SL-Distanz * Punktwert)
// ---------------------------------------------------------------------------
calcQty(float slDist) =>
    riskUsd = strategy.equity * riskPct / 100.0
    perCon  = slDist * syminfo.pointvalue
    qty     = perCon > 0 ? math.floor(riskUsd / perCon) : 0
    math.min(math.max(qty, 0), maxContracts)

// ---------------------------------------------------------------------------
// ENTRIES — nur auf bestätigten Bars [Anti-Repaint]
// ---------------------------------------------------------------------------
// [R3]+[R4]+[R5] Long-Bedingung
longCond = allowNewTrades and strategy.position_size == 0 and trendUp and
     bullEngulf and rsiOk and (not useEma50 or close > ema50) and
     low <= swingLow + proxAtrMult * atr

// Spiegel-Short
shortCond = allowNewTrades and strategy.position_size == 0 and trendDn and
     bearEngulf and rsiOk and (not useEma50 or close < ema50) and
     high >= swingHigh - proxAtrMult * atr

if longCond and barstate.isconfirmed
    // [R6] Stop unter Swing-Low bzw. ATR-basiert
    slPrice = stopMode == "Swing" ? swingLow - swingBufMult * atr : close - atrStopMult * atr
    slDist  = close - slPrice
    if slDist > 0
        qty = calcQty(slDist)
        if qty >= 1
            // [R7] TP = Entry + RR * SL-Distanz
            tpPrice = close + rrTarget * slDist
            strategy.entry("Long", strategy.long, qty = qty)
            strategy.exit("LongX", "Long", stop = slPrice, limit = tpPrice)
            rs.tradesToday += 1

if shortCond and barstate.isconfirmed
    slPrice = stopMode == "Swing" ? swingHigh + swingBufMult * atr : close + atrStopMult * atr
    slDist  = slPrice - close
    if slDist > 0
        qty = calcQty(slDist)
        if qty >= 1
            tpPrice = close - rrTarget * slDist
            strategy.entry("Short", strategy.short, qty = qty)
            strategy.exit("ShortX", "Short", stop = slPrice, limit = tpPrice)
            rs.tradesToday += 1

// [R8] TIME-STOP: Scalp nicht zum Swing werden lassen
if strategy.opentrades > 0 and barstate.isconfirmed
    entryBar = strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    if bar_index - entryBar >= maxBarsHold
        strategy.close_all(comment = "Time-Stop")

// [R2] Session-Ende: flatten (kein Overnight-Risiko auf Prop-Konto)
if closeEod and not inSession and strategy.position_size != 0 and barstate.isconfirmed
    strategy.close_all(comment = "EOD flat")

// ---------------------------------------------------------------------------
// DASHBOARD (table.new): Live-Statistiken
// ---------------------------------------------------------------------------
var table dash = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))

// Dashboard-Zelle (globale Funktion — Pine erlaubt keine lokalen Deklarationen)
cell(int r, string k, string v, color c) =>
    table.cell(dash, 0, r, k, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if showDash and barstate.islast
    winRate = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : na
    pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    cell(0, "S1 Gold TPE", rs.killed ? "KILLED" : rs.dayHalted ? "DAY HALT" : "AKTIV", rs.killed ? color.red : rs.dayHalted ? color.orange : color.lime)
    cell(1, "Trades (gesamt)", str.tostring(strategy.closedtrades), color.white)
    cell(2, "Win-Rate", na(winRate) ? "n/a" : str.tostring(winRate, "#.1") + "%", color.white)
    cell(3, "Profit Factor", na(pf) ? "n/a" : str.tostring(pf, "#.##"), na(pf) ? color.gray : pf >= 1 ? color.lime : color.red)
    cell(4, "Tages-DD", str.tostring(rs.dailyDrawdownPct(), "#.##") + "%", rs.dailyDrawdownPct() > dailyLossPct * 0.66 ? color.orange : color.white)
    cell(5, "Rest-Tagesbudget", "$" + str.tostring(rs.remainingDayBudget(), "#"), color.white)
    cell(6, "Gesamt-DD (Peak)", str.tostring(rs.totalDrawdownPct(), "#.##") + "%", rs.totalDrawdownPct() > maxDdPct * 0.66 ? color.orange : color.white)
    cell(7, "Trades heute", str.tostring(rs.tradesToday) + " / " + str.tostring(maxTradesDay), color.white)

// ---------------------------------------------------------------------------
// VISUALS
// ---------------------------------------------------------------------------
plot(ema50, "EMA50 (5m)", color = color.new(color.orange, 30))
plotshape(longCond and barstate.isconfirmed,  "Long Setup",  shape.triangleup,   location.belowbar, color.lime,  size = size.tiny)
plotshape(shortCond and barstate.isconfirmed, "Short Setup", shape.triangledown, location.abovebar, color.red,   size = size.tiny)
bgcolor(rs.killed ? color.new(color.red, 85) : rs.dayHalted ? color.new(color.orange, 88) : inSession ? na : color.new(color.gray, 94))
