//@version=6
// =============================================================================
//  STRATEGY 2 — Gold 1m/5m Mean-Reversion RSI + 200 EMA (XAUUSD / GC / MGC)
// =============================================================================
//  Recherche-Basis: LuxAlgo "XAUUSD 1-Minute Scalping Strategy — Advanced
//  Strategy for Exits" (RSI Oversold/Overbought + 200-EMA-Trendfilter,
//  fixe TP/SL-Distanzen, 1:2 RR).
//
//  REGELN (Recherche-Mapping mit [R#]):
//   [R1] Timeframe 1m oder 5m; 200-EMA-Trendfilter: Close > EMA200 = Uptrend
//   [R2] Long: Uptrend + RSI(14) fällt unter Oversold (30) und dreht wieder
//        HOCH (optional: echter Re-Cross über die Schwelle gegen "falling knife")
//   [R3] Short: Downtrend + RSI über Overbought (70) und dreht runter
//   [R4] Fixe Exits: TP = 10 Pips, SL = 5 Pips (1 Pip = 0.10 Gold-Punkte),
//        alternativ ATR-Modus für Futures-Volatilitätsanpassung
//   [R5] Max. Haltezeit 15-20 min (Time-Stop)
//   [R6] Max. 1 offene Position (kein Pyramiding, keine Über-Exponierung)
//   [R7] Session-Filter London/NY
//   [R8] Risiko 0.25-0.3%/Trade (High-Frequency -> kleiner), Daily-Loss-Limit
//        2.5-3%, Max-DD-Kill-Switch, Max-Trades/Tag
//
//  ANTI-REPAINT: Entries nur auf barstate.isconfirmed; keine HTF-Requests
//  nötig (alles auf Chart-TF). process_orders_on_close=true.
//
//  Pine v6: UDT+Methods für Risk-State, Short-Circuit-Auswertung,
//  kein Order-Limit. Für GC: Tick 0.1 = $10/Kontrakt; MGC: $1.
// =============================================================================
strategy("S2 Gold Mean-Reversion RSI + EMA200 [v6]",
     shorttitle            = "S2 GOLD MR",
     overlay               = true,
     initial_capital       = 50000,
     currency              = currency.USD,
     default_qty_type      = strategy.fixed,
     default_qty_value     = 1,
     pyramiding            = 0,                       // [R6]
     commission_type       = strategy.commission.cash_per_contract,
     commission_value      = 2.5,
     slippage              = 3,                       // 3 Ticks — 1m-Scalping konservativ
     margin_long           = 5,
     margin_short          = 5,
     process_orders_on_close = true,
     calc_on_every_tick    = false,
     use_bar_magnifier     = false)

// ---------------------------------------------------------------------------
// INPUTS
// ---------------------------------------------------------------------------
grpSig = "Signal"
emaLen     = input.int(200, "Trend-EMA Länge", minval = 10, group = grpSig, tooltip = "[R1] 200 EMA auf dem aktiven Timeframe. Close darüber = nur Longs, darunter = nur Shorts.")
rsiLen     = input.int(14,  "RSI Länge", minval = 2, group = grpSig)
rsiOs      = input.float(30, "RSI Oversold", minval = 5, maxval = 45, group = grpSig, tooltip = "[R2] Long-Trigger-Schwelle.")
rsiOb      = input.float(70, "RSI Overbought", minval = 55, maxval = 95, group = grpSig, tooltip = "[R3] Short-Trigger-Schwelle.")
useRecross = input.bool(true, "Auf RSI-Re-Cross warten (kein 'falling knife')", group = grpSig, tooltip = "[R2] true: Entry erst wenn RSI wieder ÜBER Oversold (bzw. UNTER Overbought) kreuzt. false: RSI dreht lediglich (rsi > rsi[1]).")

grpExit = "Exits"
exitMode   = input.string("Pips", "Exit-Modus", options = ["Pips", "ATR"], group = grpExit, tooltip = "[R4] Pips: fixe Distanzen wie LuxAlgo (10/5 Pips). ATR: volatilitätsadaptiv für Futures.")
pipSize    = input.float(0.10, "Pip-Größe (Preis)", step = 0.01, group = grpExit, tooltip = "[R4] Recherche: 0.10 Gold-Punkte = 1 Pip. An Broker/Kontrakt anpassen.")
tpPips     = input.float(10.0, "Take-Profit (Pips)", step = 0.5, group = grpExit)
slPips     = input.float(5.0,  "Stop-Loss (Pips)", step = 0.5, group = grpExit, tooltip = "[R4] 10/5 = 1:2 RR wie in der LuxAlgo-Beschreibung.")
atrLen     = input.int(14,    "ATR Länge (ATR-Modus)", minval = 1, group = grpExit)
atrSlMult  = input.float(1.0, "ATR SL-Multiplikator", step = 0.05, group = grpExit)
rrTarget   = input.float(2.0, "RR-Ziel (ATR-Modus)", step = 0.1, group = grpExit)
maxBarsHold = input.int(20,   "Time-Stop (Bars)", minval = 1, group = grpExit, tooltip = "[R5] 1m-Chart: 20 Bars = 20 min. 5m-Chart entsprechend reduzieren (z.B. 4).")

grpSess = "Session"
sessStr  = input.session("0800-1600", "Handels-Session", group = grpSess, tooltip = "[R7] London + NY.")
sessTz   = input.string("Europe/London", "Session-Zeitzone", group = grpSess)
closeEod = input.bool(true, "Am Session-Ende flatten", group = grpSess)

grpRisk = "Risiko & Prop-Firm-Limits"
riskPct      = input.float(0.3, "Risiko pro Trade (% Equity)", step = 0.05, minval = 0.05, maxval = 2.0, group = grpRisk, tooltip = "[R8] High-Frequency-Scalping -> niedriger als Strategie 1.")
maxContracts = input.int(10, "Max. Kontrakte", minval = 1, group = grpRisk)
maxTradesDay = input.int(10, "Max. Trades pro Tag", minval = 1, group = grpRisk)
dailyLossPct = input.float(2.5, "Daily-Loss-Limit (%)", step = 0.25, minval = 0.5, group = grpRisk, tooltip = "[R8] Konservativer als die Prop-Firm-Grenze (z.B. Firm 3-5% -> hier 2.5%).")
maxDdPct     = input.float(6.0, "Max-Drawdown-Kill-Switch (%)", step = 0.25, minval = 1.0, group = grpRisk)
showDash     = input.bool(true, "Dashboard anzeigen", group = grpRisk)

// ---------------------------------------------------------------------------
// v6 UDT + METHODS: Risiko-/Tages-State (identische Logik wie Strategie 1)
// ---------------------------------------------------------------------------
type RiskState
    float dayStartEquity = na
    float peakEquity     = na
    int   tradesToday    = 0
    bool  dayHalted      = false
    bool  killed         = false

method newDay(RiskState self) =>
    self.dayStartEquity := strategy.equity
    self.tradesToday    := 0
    self.dayHalted      := false

method dailyDrawdownPct(RiskState self) =>
    na(self.dayStartEquity) or self.dayStartEquity <= 0 ? 0.0 :
     100.0 * (self.dayStartEquity - strategy.equity) / self.dayStartEquity

method totalDrawdownPct(RiskState self) =>
    na(self.peakEquity) or self.peakEquity <= 0 ? 0.0 :
     100.0 * (self.peakEquity - strategy.equity) / self.peakEquity

method remainingDayBudget(RiskState self) =>
    na(self.dayStartEquity) ? 0.0 :
     math.max(0.0, self.dayStartEquity * dailyLossPct / 100.0 - (self.dayStartEquity - strategy.equity))

var RiskState rs = RiskState.new()

// ---------------------------------------------------------------------------
// SIGNALLOGIK
// ---------------------------------------------------------------------------
inSession = not na(time(timeframe.period, sessStr, sessTz))   // [R7]
ema200 = ta.ema(close, emaLen)                                 // [R1]
rsi    = ta.rsi(close, rsiLen)
atr    = ta.atr(atrLen)

// [R2] Long-Trigger: RSI war unter Oversold und ...
//  - Re-Cross-Modus: kreuzt jetzt wieder über die Schwelle (ta.crossover)
//  - Turn-Modus: ist unter der Schwelle und dreht hoch (rsi > rsi[1])
longTrigger  = useRecross ? ta.crossover(rsi, rsiOs) : (rsi < rsiOs and rsi > rsi[1])
// [R3] Short-Trigger (Spiegel)
shortTrigger = useRecross ? ta.crossunder(rsi, rsiOb) : (rsi > rsiOb and rsi < rsi[1])

// ---------------------------------------------------------------------------
// [R8] DAILY-LOSS-LIMITER + KILL-SWITCH
// ---------------------------------------------------------------------------
isNewDay = ta.change(time("D")) != 0
if isNewDay
    rs.newDay()
if na(rs.peakEquity) or strategy.equity > rs.peakEquity
    rs.peakEquity := strategy.equity

if not rs.killed and rs.totalDrawdownPct() >= maxDdPct
    rs.killed := true
    strategy.close_all(comment = "KILL max-DD", immediately = true)
    strategy.cancel_all()

if not rs.dayHalted and rs.dailyDrawdownPct() >= dailyLossPct
    rs.dayHalted := true
    strategy.close_all(comment = "HALT daily-loss", immediately = true)
    strategy.cancel_all()

allowNewTrades = not rs.killed and not rs.dayHalted and inSession and rs.tradesToday < maxTradesDay

// ---------------------------------------------------------------------------
// POSITION SIZING [R8]
// ---------------------------------------------------------------------------
calcQty(float slDist) =>
    riskUsd = strategy.equity * riskPct / 100.0
    perCon  = slDist * syminfo.pointvalue
    qty     = perCon > 0 ? math.floor(riskUsd / perCon) : 0
    math.min(math.max(qty, 0), maxContracts)

// SL/TP-Distanzen je nach Exit-Modus [R4]
slDist = exitMode == "Pips" ? slPips * pipSize : atrSlMult * atr
tpDist = exitMode == "Pips" ? tpPips * pipSize : rrTarget * atrSlMult * atr

// ---------------------------------------------------------------------------
// ENTRIES — nur bestätigte Bars, nur flat [R6]
// ---------------------------------------------------------------------------
longCond  = allowNewTrades and strategy.position_size == 0 and close > ema200 and longTrigger    // [R1]+[R2]
shortCond = allowNewTrades and strategy.position_size == 0 and close < ema200 and shortTrigger   // [R1]+[R3]

if longCond and barstate.isconfirmed and slDist > 0
    qty = calcQty(slDist)
    if qty >= 1
        strategy.entry("Long", strategy.long, qty = qty)
        strategy.exit("LongX", "Long", stop = close - slDist, limit = close + tpDist)
        rs.tradesToday += 1

if shortCond and barstate.isconfirmed and slDist > 0
    qty = calcQty(slDist)
    if qty >= 1
        strategy.entry("Short", strategy.short, qty = qty)
        strategy.exit("ShortX", "Short", stop = close + slDist, limit = close - tpDist)
        rs.tradesToday += 1

// [R5] TIME-STOP
if strategy.opentrades > 0 and barstate.isconfirmed
    entryBar = strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    if bar_index - entryBar >= maxBarsHold
        strategy.close_all(comment = "Time-Stop")

// [R7] Session-Ende: flatten
if closeEod and not inSession and strategy.position_size != 0 and barstate.isconfirmed
    strategy.close_all(comment = "EOD flat")

// ---------------------------------------------------------------------------
// DASHBOARD
// ---------------------------------------------------------------------------
var table dash = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))

cell(int r, string k, string v, color c) =>
    table.cell(dash, 0, r, k, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if showDash and barstate.islast
    winRate = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : na
    pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    cell(0, "S2 Gold MR", rs.killed ? "KILLED" : rs.dayHalted ? "DAY HALT" : "AKTIV", rs.killed ? color.red : rs.dayHalted ? color.orange : color.lime)
    cell(1, "Trades (gesamt)", str.tostring(strategy.closedtrades), color.white)
    cell(2, "Win-Rate", na(winRate) ? "n/a" : str.tostring(winRate, "#.1") + "%", color.white)
    cell(3, "Profit Factor", na(pf) ? "n/a" : str.tostring(pf, "#.##"), na(pf) ? color.gray : pf >= 1 ? color.lime : color.red)
    cell(4, "Tages-DD", str.tostring(rs.dailyDrawdownPct(), "#.##") + "%", rs.dailyDrawdownPct() > dailyLossPct * 0.66 ? color.orange : color.white)
    cell(5, "Rest-Tagesbudget", "$" + str.tostring(rs.remainingDayBudget(), "#"), color.white)
    cell(6, "Gesamt-DD (Peak)", str.tostring(rs.totalDrawdownPct(), "#.##") + "%", rs.totalDrawdownPct() > maxDdPct * 0.66 ? color.orange : color.white)
    cell(7, "Trades heute", str.tostring(rs.tradesToday) + " / " + str.tostring(maxTradesDay), color.white)

// ---------------------------------------------------------------------------
// VISUALS
// ---------------------------------------------------------------------------
plot(ema200, "EMA200", color = color.new(color.blue, 20), linewidth = 2)
plotshape(longCond and barstate.isconfirmed,  "Long",  shape.triangleup,   location.belowbar, color.lime, size = size.tiny)
plotshape(shortCond and barstate.isconfirmed, "Short", shape.triangledown, location.abovebar, color.red,  size = size.tiny)
bgcolor(rs.killed ? color.new(color.red, 85) : rs.dayHalted ? color.new(color.orange, 88) : inSession ? na : color.new(color.gray, 94))
